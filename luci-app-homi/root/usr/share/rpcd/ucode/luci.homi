#!/usr/bin/ucode

'use strict';

import { popen } from 'fs';

const home_dir = '/etc/homi';
const default_config = home_dir + '/config.yaml';
const sub_config = home_dir + '/subscription.yaml';

/* 订阅地址合法性：http/https 开头，不含空白、引号及 shell 元字符（& 允许，sed 时转义） */
function valid_sub_url(url) {
	if (type(url) != 'string')
		return false;
	if (length(url) < 12 || length(url) > 2048)
		return false;
	if (substr(url, 0, 7) != 'http://' && substr(url, 0, 8) != 'https://')
		return false;
	const bad = [' ', '\t', '\n', '\r', "'", '"', '`', '\\', '$', ';', '|', '<', '>'];
	for (let i = 0; i < length(bad); i++) {
		if (index(url, bad[i]) >= 0)
			return false;
	}
	return true;
}

/* 读 UCI 中的订阅地址列表（sub_count + sub_url_N），兼容 r4 的单 subscription_url */
function sub_urls() {
	const urls = [];
	let n = -1;
	let process = popen("uci -q get homi.main.sub_count 2>/dev/null");
	if (process) {
		const s = trim(process.read('all'));
		process.close();
		if (length(s) > 0)
			n = int(s);
	}
	if (n < 0) {
		process = popen("uci -q get homi.main.subscription_url 2>/dev/null");
		if (process) {
			const old = trim(process.read('all'));
			process.close();
			if (length(old) > 0)
				push(urls, old);
		}
		return urls;
	}
	for (let i = 1; i <= n; i++) {
		process = popen(`uci -q get homi.main.sub_url_${i} 2>/dev/null`);
		if (!process)
			continue;
		const u = trim(process.read('all'));
		process.close();
		if (length(u) > 0)
			push(urls, u);
	}
	return urls;
}

/* 写回订阅列表（同时清掉 r4 旧字段与超长序号残留） */
function save_sub_urls(urls) {
	let cmd = "uci -q delete homi.main.subscription_url; ";
	cmd += `uci set homi.main.sub_count='${length(urls)}'; `;
	for (let i = 1; i <= length(urls); i++)
		cmd += `uci set homi.main.sub_url_${i}='${replace(urls[i - 1], "'", "'\\''")}'; `;
	for (let i = length(urls) + 1; i <= 32; i++)
		cmd += `uci -q delete homi.main.sub_url_${i}; `;
	cmd += "uci commit homi";
	return system(cmd) == 0;
}

function clear_sub_urls() {
	let cmd = "uci -q delete homi.main.subscription_url; uci -q delete homi.main.sub_count; ";
	for (let i = 1; i <= 32; i++)
		cmd += `uci -q delete homi.main.sub_url_${i}; `;
	cmd += "uci commit homi";
	return system(cmd) == 0;
}

/* 调生成脚本重建 subscription.yaml 并设为正使用配置。
   注意：经 connector 推到 GitHub 的文件可执行位会丢失（全是 100644），
   luci.mk 的 root/ 又是按 git mode 原样安装，所以这里走 /bin/sh 调用，
   不依赖脚本本身的 +x。 */
function regen_subscription(urls) {
	if (length(urls) == 0)
		return false;
	let cmd = "/bin/sh /usr/sbin/homi-gen-subscription";
	for (let i = 0; i < length(urls); i++)
		cmd += ` '${replace(urls[i], "'", "'\\''")}'`;
	const rc = system(cmd + " >/dev/null 2>&1");
	if (rc != 0) {
		system(`/usr/sbin/homi-log "[App] 订阅生成脚本异常退出，退出码: ${rc}" 2>/dev/null`);
		return false;
	}
	return system(`uci set homi.main.config_file='${sub_config}'; uci commit homi`) == 0;
}

/* 从 UCI 读取当前生效的配置文件路径 */
function active_config() {
	let cfg = default_config;
	const process = popen("uci -q get homi.main.config_file 2>/dev/null");
	if (process) {
		const out = trim(process.read('all'));
		process.close();
		if (length(out) > 0)
			cfg = out;
	}
	return cfg;
}

/* 读面板连接信息（controller/secret/ui），供 dashboard 与 open_dashboard 共用 */
function dashboard_info() {
	const config_path = active_config();
	let cfg = {};
	const process = popen(`yq -o=json '.' '${config_path}' 2>/dev/null`);
	if (process) {
		const out = process.read('all');
		process.close();
		try {
			cfg = json(out);
		} catch (e) {
			cfg = {};
		}
	}
	const ctl = cfg['external-controller'];
	const ctl_tls = cfg['external-controller-tls'];
	if (!ctl && !ctl_tls)
		return { error: 'not_configured' };
	return {
		controller: ctl_tls ?? ctl,
		tls: ctl_tls ? true : false,
		secret: cfg['secret'] ?? '',
		ui: cfg['external-ui'] ?? ''
	};
}

const methods = {
	version: {
		call: function() {
			let process;
			let app = '';
			if (system('command -v opkg') == 0) {
				process = popen('opkg list-installed luci-app-homi 2>/dev/null | cut -d " " -f 3');
				if (process) {
					app = trim(process.read('all'));
					process.close();
				}
			} else if (system('command -v apk') == 0) {
				process = popen('apk list -I luci-app-homi 2>/dev/null | cut -d " " -f 1 | cut -d "-" -f 4');
				if (process) {
					app = trim(process.read('all'));
					process.close();
				}
			}
			let core = '';
			process = popen('mihomo -v 2>/dev/null | grep -i mihomo | cut -d " " -f 3');
			if (process) {
				core = trim(process.read('all'));
				process.close();
			}
			return { app: app, core: core, config: active_config() };
		}
	},
	test_config: {
		args: { path: '' },
		call: function(req) {
			const cfg = req.args?.path ?? active_config();
			/* 只允许 home_dir 下的文件，防止路径穿越 */
			if (index(cfg, home_dir + '/') != 0) {
				system(`/usr/sbin/homi-log '[App] 校验拒绝：非法路径' 2>/dev/null`);
				return { success: false, error: 'invalid_path' };
			}
			/* shell 单引号转义防注入 */
			const esc = replace(cfg, "'", "'\\''");
			/* 15 秒超时：mihomo -t 首次运行时会下载 MMDB，网络卡住时不能无限等，
			   超过 LuCI 的 20 秒 RPC 超时只会导致前端报 XHR timeout 且后端进程残留 */
			const rc = system(`timeout 15 /usr/bin/mihomo -t -d '${home_dir}' -f '${esc}' >/dev/null 2>&1`);
			if (rc == 124) {
				system(`/usr/sbin/homi-log '[App] 校验超时（15秒）：${esc}' 2>/dev/null`);
				return { success: false, error: 'timeout' };
			}
			const ok = rc == 0;
			if (!ok)
				system(`/usr/sbin/homi-log '[App] 校验失败：${esc}' 2>/dev/null`);
			return { success: ok };
		}
	},
	set_config: {
		args: { path: '' },
		call: function(req) {
			const cfg = req.args?.path ?? '';
			if (index(cfg, home_dir + '/') != 0)
				return { success: false, error: 'invalid_path' };
			const esc = replace(cfg, "'", "'\\''");
			const ok = system(`uci set homi.main.config_file='${esc}' && uci commit homi`) == 0;
			return { success: ok };
		}
	},
	list_configs: {
		call: function() {
			const active = active_config();
			const files = [];
			const process = popen(`ls -1 '${home_dir}' 2>/dev/null`);
			if (process) {
				const out = process.read('all');
				process.close();
				const names = split(trim(out), '\n');
				for (let i = 0; i < length(names); i++) {
					const name = trim(names[i]);
					if (length(name) == 0)
						continue;
					const lower = lc(name);
					if (substr(lower, length(lower) - 5) == '.yaml' || substr(lower, length(lower) - 4) == '.yml')
						push(files, { name: name, path: home_dir + '/' + name, active: (home_dir + '/' + name) == active });
				}
			}
			return { configs: files, active: active };
		}
	},
	delete_config: {
		args: { path: '' },
		call: function(req) {
			const cfg = req.args?.path ?? '';
			if (index(cfg, home_dir + '/') != 0)
				return { success: false, error: 'invalid_path' };
			if (cfg == active_config())
				return { success: false, error: 'is_active' };
			const esc = replace(cfg, "'", "'\\''");
			const ok = system(`rm -f '${esc}'`) == 0;
			return { success: ok };
		}
	},
	dashboard: {
		call: function() {
			return dashboard_info();
		}
	},
	/* 打开面板：一键直达。先补齐面板文件（就绪则不管；嵌套则展平；缺失则下载），
	   再返回连接信息。脚本走 /bin/sh 调用，不依赖其 +x 位。 */
	open_dashboard: {
		call: function() {
			const info = dashboard_info();
			if (info.error)
				return { success: false, error: info.error };
			/* external-ui 相对路径按 mihomo -d（即 home_dir）解析 */
			let u = info.ui || 'ui';
			if (substr(u, 0, 1) != '/')
				u = home_dir + '/' + u;
			const esc = replace(u, "'", "'\\''");
			system(`/bin/sh /usr/sbin/homi-update-dashboard --ensure '${esc}' >/dev/null 2>&1`);
			if (system(`test -f '${esc}/index.html'`) != 0) {
				system(`/usr/sbin/homi-log '[App] 打开面板失败：面板文件缺失' 2>/dev/null`);
				return { success: false, error: 'ui_missing' };
			}
			info.success = true;
			return info;
		}
	},
	update_dashboard: {
		call: function() {
			const ok = system('/usr/sbin/homi-update-dashboard >/dev/null 2>&1') == 0;
			return { success: ok };
		}
	},
	log_msg: {
		args: { msg: '' },
		call: function(req) {
			const msg = req.args?.msg ?? '';
			const esc = replace(msg, "'", "'\\''");
			system(`/usr/sbin/homi-log '${esc}' 2>/dev/null`);
			return { success: true };
		}
	},
	get_subscriptions: {
		call: function() {
			const urls = sub_urls();
			return { urls: urls, active: length(urls) > 0 && active_config() == sub_config };
		}
	},
	add_subscription: {
		args: { url: '' },
		call: function(req) {
			const url = trim(req.args?.url ?? '');
			if (!valid_sub_url(url)) {
				system(`/usr/sbin/homi-log '[App] 订阅地址不合法，已拒绝' 2>/dev/null`);
				return { success: false, error: 'invalid_url' };
			}
			const urls = sub_urls();
			for (let i = 0; i < length(urls); i++) {
				if (urls[i] == url)
					return { success: false, error: 'duplicate' };
			}
			push(urls, url);
			if (!regen_subscription(urls)) {
				system(`/usr/sbin/homi-log '[App] 订阅配置生成失败' 2>/dev/null`);
				return { success: false, error: 'generate_failed' };
			}
			if (!save_sub_urls(urls))
				return { success: false, error: 'uci_failed' };
			system(`/usr/sbin/homi-log '[App] 已添加订阅并设为正使用配置' 2>/dev/null`);
			return { success: true, path: sub_config };
		}
	},
	update_subscription: {
		args: { index: '', url: '' },
		call: function(req) {
			const idx = int(req.args?.index ?? '0');
			const url = trim(req.args?.url ?? '');
			if (!valid_sub_url(url)) {
				system(`/usr/sbin/homi-log '[App] 订阅地址不合法，已拒绝' 2>/dev/null`);
				return { success: false, error: 'invalid_url' };
			}
			const urls = sub_urls();
			if (idx < 1 || idx > length(urls))
				return { success: false, error: 'bad_index' };
			urls[idx - 1] = url;
			if (!regen_subscription(urls)) {
				system(`/usr/sbin/homi-log '[App] 订阅配置生成失败' 2>/dev/null`);
				return { success: false, error: 'generate_failed' };
			}
			if (!save_sub_urls(urls))
				return { success: false, error: 'uci_failed' };
			system(`/usr/sbin/homi-log '[App] 订阅地址已更新' 2>/dev/null`);
			return { success: true };
		}
	},
	remove_subscription: {
		args: { index: '' },
		call: function(req) {
			const idx = int(req.args?.index ?? '0');
			const urls = sub_urls();
			if (idx < 1 || idx > length(urls))
				return { success: false, error: 'bad_index' };
			const rest = [];
			for (let i = 0; i < length(urls); i++) {
				if (i != idx - 1)
					push(rest, urls[i]);
			}
			const was_active = active_config() == sub_config;
			if (length(rest) == 0) {
				clear_sub_urls();
				system(`rm -f '${sub_config}'`);
				if (was_active) {
					system(`uci -q delete homi.main.config_file; uci commit homi`);
					system(`/etc/init.d/homi stop >/dev/null 2>&1`);
					system(`/usr/sbin/homi-log '[App] 订阅已全部删除，正使用的订阅配置已失效，服务已停止' 2>/dev/null`);
				} else {
					system(`/usr/sbin/homi-log '[App] 订阅已全部删除' 2>/dev/null`);
				}
				return { success: true, stopped: was_active };
			}
			if (!regen_subscription(rest)) {
				system(`/usr/sbin/homi-log '[App] 订阅配置生成失败' 2>/dev/null`);
				return { success: false, error: 'generate_failed' };
			}
			if (!save_sub_urls(rest))
				return { success: false, error: 'uci_failed' };
			system(`/usr/sbin/homi-log '[App] 已删除一条订阅' 2>/dev/null`);
			return { success: true, stopped: false };
		}
	}
};

return { 'luci.homi': methods };
