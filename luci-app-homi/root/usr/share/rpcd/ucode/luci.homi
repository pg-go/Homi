#!/usr/bin/ucode

'use strict';

import { popen } from 'fs';

const home_dir = '/etc/homi';
const default_config = home_dir + '/config.yaml';
const builtin_template = '/usr/share/homi/builtin.yaml';
const sub_config = home_dir + '/subscription.yaml';

/* 订阅地址合法性：http/https 开头，不含空白、引号及 shell 元字符（& 允许，sed 时转义） */
function valid_sub_url(url) {
	if (type(url) != 'string')
		return false;
	if (length(url) < 12 || length(url) > 2048)
		return false;
	if (substr(url, 0, 7) != 'http://' && substr(url, 0, 8) != 'https://')
		return false;
	const bad = [' ', '\t', '\n', '\r', "'", '"', '`', '\\', '$', ';', '|', '<', '>'];
	for (let i = 0; i < length(bad); i++) {
		if (index(url, bad[i]) >= 0)
			return false;
	}
	return true;
}

/* 读 UCI 中的订阅地址 */
function sub_url() {
	let url = '';
	const process = popen("uci -q get homi.main.subscription_url 2>/dev/null");
	if (process) {
		url = trim(process.read('all'));
		process.close();
	}
	return url;
}

/* 从 UCI 读取当前生效的配置文件路径 */
function active_config() {
	let cfg = default_config;
	const process = popen("uci -q get homi.main.config_file 2>/dev/null");
	if (process) {
		const out = trim(process.read('all'));
		process.close();
		if (length(out) > 0)
			cfg = out;
	}
	return cfg;
}

const methods = {
	version: {
		call: function() {
			let process;
			let app = '';
			if (system('command -v opkg') == 0) {
				process = popen('opkg list-installed luci-app-homi 2>/dev/null | cut -d " " -f 3');
				if (process) {
					app = trim(process.read('all'));
					process.close();
				}
			} else if (system('command -v apk') == 0) {
				process = popen('apk list -I luci-app-homi 2>/dev/null | cut -d " " -f 1 | cut -d "-" -f 4');
				if (process) {
					app = trim(process.read('all'));
					process.close();
				}
			}
			let core = '';
			process = popen('mihomo -v 2>/dev/null | grep -i mihomo | cut -d " " -f 3');
			if (process) {
				core = trim(process.read('all'));
				process.close();
			}
			return { app: app, core: core, config: active_config() };
		}
	},
	test_config: {
		args: { path: '' },
		call: function(req) {
			const cfg = req.args?.path ?? active_config();
			/* 只允许 home_dir 下的文件，防止路径穿越 */
			if (index(cfg, home_dir + '/') != 0) {
				system(`/usr/sbin/homi-log '[App] 校验拒绝：非法路径' 2>/dev/null`);
				return { success: false, error: 'invalid_path' };
			}
			/* shell 单引号转义防注入 */
			const esc = replace(cfg, "'", "'\\''");
			const ok = system(`/usr/bin/mihomo -t -d '${home_dir}' -f '${esc}' >/dev/null 2>&1`) == 0;
			if (!ok)
				system(`/usr/sbin/homi-log '[App] 校验失败：${esc}' 2>/dev/null`);
			return { success: ok };
		}
	},
	set_config: {
		args: { path: '' },
		call: function(req) {
			const cfg = req.args?.path ?? '';
			if (index(cfg, home_dir + '/') != 0)
				return { success: false, error: 'invalid_path' };
			const esc = replace(cfg, "'", "'\\''");
			const ok = system(`uci set homi.main.config_file='${esc}' && uci commit homi`) == 0;
			return { success: ok };
		}
	},
	list_configs: {
		call: function() {
			const active = active_config();
			const files = [];
			const process = popen(`ls -1 '${home_dir}' 2>/dev/null`);
			if (process) {
				const out = process.read('all');
				process.close();
				const names = split(trim(out), '\n');
				for (let i = 0; i < length(names); i++) {
					const name = trim(names[i]);
					if (length(name) == 0)
						continue;
					const lower = lc(name);
					if (substr(lower, length(lower) - 5) == '.yaml' || substr(lower, length(lower) - 4) == '.yml')
						push(files, { name: name, path: home_dir + '/' + name, active: (home_dir + '/' + name) == active });
				}
			}
			return { configs: files, active: active };
		}
	},
	delete_config: {
		args: { path: '' },
		call: function(req) {
			const cfg = req.args?.path ?? '';
			if (index(cfg, home_dir + '/') != 0)
				return { success: false, error: 'invalid_path' };
			if (cfg == active_config())
				return { success: false, error: 'is_active' };
			const esc = replace(cfg, "'", "'\\''");
			const ok = system(`rm -f '${esc}'`) == 0;
			return { success: ok };
		}
	},
	dashboard: {
		call: function() {
			const config_path = active_config();
			let cfg = {};
			const process = popen(`yq -o=json '.' '${config_path}' 2>/dev/null`);
			if (process) {
				const out = process.read('all');
				process.close();
				try {
					cfg = json(out);
				} catch (e) {
					cfg = {};
				}
			}
			const ctl = cfg['external-controller'];
			const ctl_tls = cfg['external-controller-tls'];
			if (!ctl && !ctl_tls) {
				return { error: 'not_configured' };
			}
			return {
				controller: ctl_tls ?? ctl,
				tls: ctl_tls ? true : false,
				secret: cfg['secret'] ?? '',
				ui: cfg['external-ui'] ?? ''
			};
		}
	},
	update_dashboard: {
		call: function() {
			const ok = system('/usr/sbin/homi-update-dashboard >/dev/null 2>&1') == 0;
			return { success: ok };
		}
	},
	log_msg: {
		args: { msg: '' },
		call: function(req) {
			const msg = req.args?.msg ?? '';
			const esc = replace(msg, "'", "'\\''");
			system(`/usr/sbin/homi-log '${esc}' 2>/dev/null`);
			return { success: true };
		}
	},
	get_subscription: {
		call: function() {
			const url = sub_url();
			const exists = length(url) > 0 && system(`test -f '${sub_config}'`) == 0;
			return { url: url, active: exists && active_config() == sub_config };
		}
	},
	set_subscription: {
		args: { url: '' },
		call: function(req) {
			const url = trim(req.args?.url ?? '');
			if (!valid_sub_url(url)) {
				system(`/usr/sbin/homi-log '[App] 订阅地址不合法，已拒绝' 2>/dev/null`);
				return { success: false, error: 'invalid_url' };
			}
			if (system(`test -f '${builtin_template}'`) != 0)
				return { success: false, error: 'no_template' };
			/* sed 替换占位符：& 在替换串中有特殊含义，先转义；URL 已排除单引号与 | 分隔符 */
			const esc_url = replace(url, '&', '\\&');
			if (system(`sed 's|url: "订阅URL"|url: "${esc_url}"|' '${builtin_template}' > '${sub_config}.tmp'`) != 0)
				return { success: false, error: 'generate_failed' };
			if (system(`grep -q '订阅URL' '${sub_config}.tmp'`) == 0) {
				system(`rm -f '${sub_config}.tmp'`);
				return { success: false, error: 'generate_failed' };
			}
			if (system(`/usr/bin/mihomo -t -d '${home_dir}' -f '${sub_config}.tmp' >/dev/null 2>&1`) != 0) {
				system(`rm -f '${sub_config}.tmp'`);
				system(`/usr/sbin/homi-log '[App] 订阅配置生成后校验失败' 2>/dev/null`);
				return { success: false, error: 'config_invalid' };
			}
			system(`mv '${sub_config}.tmp' '${sub_config}'`);
			const esc_uci = replace(url, "'", "'\\''");
			if (system(`uci set homi.main.subscription_url='${esc_uci}'; uci set homi.main.config_file='${sub_config}'; uci commit homi`) != 0)
				return { success: false, error: 'uci_failed' };
			system(`/usr/sbin/homi-log '[App] 订阅已保存并设为正使用配置' 2>/dev/null`);
			return { success: true, path: sub_config };
		}
	},
	delete_subscription: {
		call: function() {
			const was_active = active_config() == sub_config;
			system(`uci -q delete homi.main.subscription_url; uci commit homi`);
			system(`rm -f '${sub_config}'`);
			if (was_active) {
				system(`uci -q delete homi.main.config_file; uci commit homi`);
				system(`/etc/init.d/homi stop >/dev/null 2>&1`);
				system(`/usr/sbin/homi-log '[App] 订阅已删除，正使用的订阅配置已失效，服务已停止' 2>/dev/null`);
			} else {
				system(`/usr/sbin/homi-log '[App] 订阅已删除' 2>/dev/null`);
			}
			return { success: true, stopped: was_active };
		}
	}
};

return { 'luci.homi': methods };
